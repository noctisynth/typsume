{
  "name": "@typsume/core",
  "version": "0.0.0",
  "type": "module",
  "description": "Shared Zod schema, derived TS types, and JSON Schema for typst-resume.",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./src/schema.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./src/types.ts"
    },
    "./json-schema": {
      "types": "./dist/json-schema.d.ts",
      "default": "./src/json-schema.ts"
    },
    "./fixtures/sample.json": "./test/fixtures/sample.json",
    "./fixtures/minimal.json": "./test/fixtures/minimal.json",
    "./fixtures/invalid.json": "./test/fixtures/invalid.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "dist",
    "test/fixtures"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {},
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=20.0.0"
  }
}
