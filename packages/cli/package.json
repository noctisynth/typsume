{
  "name": "@typsume/cli",
  "version": "0.1.6",
  "type": "module",
  "description": "Data-driven Typst resume compiler — build resume.json/yaml/toml → PDF via WASM (no system typst needed).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noctisynth/typsume.git",
    "directory": "packages/cli"
  },
  "bin": {
    "typsume": "./src/main.ts"
  },
  "files": [
    "src",
    "templates",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typsume": "bun run src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run scripts/package-templates.ts stage",
    "postpack": "bun run scripts/package-templates.ts clean"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@iarna/toml": "^2.2.5",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@typsume/core": "^0.1.2",
    "citty": "^0.1.6",
    "colorette": "^2.0.20",
    "consola": "^3.4.2",
    "fflate": "^0.8.3",
    "js-yaml": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
